# All-cloud, no-Docker configuration. Every setting below has a working
# local-first fallback (see app/core/config.py) — you only need to fill in
# what you're actually enabling. Each section names a specific free-tier
# service and exactly what to paste in.

# --- App ---
ENVIRONMENT=local            # local | staging | production
LOG_LEVEL=INFO

# --- Database — cloud Postgres, no Docker ----------------------------------
# Neon (neon.tech) or Supabase (supabase.com): free-tier Postgres in ~1
# minute. Copy the connection string they give you directly:
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
# Leave unset for local SQLite (./data/case_state.db).

# --- Cache + async job queue — Upstash Redis, no Docker ---------------------
# Upstash (upstash.com): free-tier Redis database in ~1 minute. Copy its
# "Redis Connect" URL (note the double-s in rediss:// — that's the TLS
# endpoint, handled identically to redis:// by the redis-py client):
# REDIS_URL=rediss://default:your-password@your-endpoint.upstash.io:6379
#
# IMPORTANT: setting REDIS_URL activates BOTH the cache layer AND the
# async job queue — but the job queue additionally requires a SEPARATE
# worker process to actually execute jobs:
#     python3 scripts/run_rq_worker.py
# Run this as its own plain process (background terminal, systemd unit,
# a small separate cloud worker instance — no Docker needed) alongside
# the API. Without it, jobs will enqueue successfully but never execute.
#
# Leave REDIS_URL unset for the in-process cache/queue fallback (fine for
# local dev and single-process deployments; no separate worker needed).

# --- Vector store — Qdrant Cloud, no Docker ---------------------------------
# cloud.qdrant.io: free-tier cluster. Set BOTH values from your cluster's
# dashboard — Qdrant Cloud requires the API key on every request, unlike
# local/self-hosted mode:
# QDRANT_URL=https://your-cluster-id.region.aws.cloud.qdrant.io:6333
# QDRANT_API_KEY=your-api-key
# Leave both unset for Qdrant's embedded local mode (./data/qdrant_local,
# no server of any kind needed).

# --- LLM — Groq (cloud, no Docker) ------------------------------------------
# console.groq.com/keys: free tier, Llama 3.3 70B, fast inference.
GROQ_API_KEY=
# Groq's model catalog changes over time — if you get a 404 from
# api.groq.com, the model below may have been renamed/deprecated. Check
# the CURRENT list at console.groq.com/docs/models and override here:
# ROUTER_MODEL=llama-3.3-70b-versatile
# Diagnose a Groq issue in isolation (separate from Graphiti/Neo4j) with:
#   python3 scripts/test_groq_connection.py

# --- Embeddings — Mistral (cloud, no Docker) --------------------------------
# console.mistral.ai/api-keys: free "Experiment" plan — generous free
# token volume. NOTE: the free plan opts your data into training by
# default; fine for this project's synthetic policy corpus, reconsider
# before sending real customer data through it.
MISTRAL_API_KEY=

# --- Reasoning/generation tiers (not yet wired to real clients — see README) -
GOOGLE_API_KEY=
COHERE_API_KEY=

# --- Carrier — EasyPost (cloud, no Docker) ----------------------------------
# easypost.com: free test-mode API key. NOTE: EasyPost's 2026 onboarding
# now requires a payment method on file before showing you a key (a real
# change from their older "no card needed" docs) — see SHIPPO_API_KEY
# below as an alternative requiring no card at all if you'd rather skip that.
EASYPOST_API_KEY=

# --- Carrier alternative — Shippo (cloud, no Docker) ------------------------
# goshippo.com: sign up directly (not through a third-party bundled
# integration), go to Settings > API, click "Create new test key" — no
# card required for this direct signup path. Starts with shippo_test_.
# EasyPost takes priority if BOTH keys are set — use one, not both.
SHIPPO_API_KEY=

# --- Payment — Stripe (cloud, no Docker) ------------------------------------
# dashboard.stripe.com/test/apikeys: free test-mode secret key.
# NOTE: written correctly against Stripe's real API but not network-tested
# from the sandbox this was built in — verify against your own account.
STRIPE_API_KEY=

# --- Observability — Langfuse Cloud (cloud, no Docker) ----------------------
# cloud.langfuse.com: free tier. Create a project, copy both keys.
# Dual-writes alongside this project's own SQL-based tracing (which
# remains primary — Langfuse is an additional hosted-UI sink).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
TRACING_ENABLED=false

# --- Guardrail thresholds (business decisions — see docs/architecture-decision.md) -
AUTO_EXECUTE_CONFIDENCE_THRESHOLD=0.90
AUTO_EXECUTE_VALUE_CEILING_USD=50.00

# --- Long-term memory graph — Neo4j Aura, no Docker (recommended) ----------
# neo4j.com/cloud/aura: free tier, ~2 minutes to set up. Activates real
# Graphiti (graph-backed episodic memory) alongside GROQ_API_KEY above —
# Graphiti needs both an LLM (Groq) and a graph store (this) to be useful.
# NEO4J_URI=neo4j+s://your-instance-id.databases.neo4j.io
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your-password
#
# Leave both unset and Graphiti still activates (as long as GROQ_API_KEY
# is set) using an EMBEDDED graph database (Kuzu) instead — no server, no
# credentials, genuinely zero setup. HONEST CAVEAT: Graphiti's own Kuzu
# driver is deprecated upstream ("the Kuzu project is no longer
# maintained, migrate to Neo4j or FalkorDB") — fine for quick local
# testing, but Neo4j Aura above is the actually-recommended path, not
# just an optional upgrade.
#
# A "CERTIFICATE_VERIFY_FAILED: self-signed certificate" or "Unable to
# retrieve routing information" error almost always means a VPN,
# corporate proxy, or antivirus's TLS/SSL inspection feature is
# intercepting the connection — not a problem with Aura's own cert.
# Diagnose this in isolation (separate from Graphiti/Groq) with:
#   python3 scripts/test_neo4j_connection.py
# KUZU_LOCAL_PATH=./data/kuzu_local   # only used when NEO4J_URI is unset

# --- Rollback switch (Phase 16) ---------------------------------------------
# Set to false to route ALL new resolution decisions to human escalation
# regardless of confidence/value/fraud-flag — proven to take effect in
# under 1 second (see tests/test_phase16_rollout.py). Does NOT weaken
# Tier 1's hard ceilings, which stay active either way.
AUTO_EXECUTION_ENABLED=true
